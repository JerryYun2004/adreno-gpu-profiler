#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint in_data[];
};

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
    uint out_data[];
};

#define ALU_STEP(x, c)       \
    x = x + c;               \
    x = x ^ (x << 13);        \
    x = x + (x >> 17);        \
    x = x ^ (x << 5);

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint x = in_data[gid];

    ALU_STEP(x, 0x9e3779b9u)
    ALU_STEP(x, 0x85ebca6bu)
    ALU_STEP(x, 0xc2b2ae35u)
    ALU_STEP(x, 0x27d4eb2fu)
    ALU_STEP(x, 0x165667b1u)
    ALU_STEP(x, 0xd3a2646cu)
    ALU_STEP(x, 0xfd7046c5u)
    ALU_STEP(x, 0xb55a4f09u)
    ALU_STEP(x, 0x243f6a88u)
    ALU_STEP(x, 0x85a308d3u)
    ALU_STEP(x, 0x13198a2eu)
    ALU_STEP(x, 0x03707344u)
    ALU_STEP(x, 0xa4093822u)
    ALU_STEP(x, 0x299f31d0u)
    ALU_STEP(x, 0x082efa98u)
    ALU_STEP(x, 0xec4e6c89u)

    out_data[gid] = x;
}
